{
  "name": "drive-narrator-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "bootstrap": "npm install --workspaces",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky",
    "dev": "npm run dev:start",
    "dev:start": "npm run dev:backend & sleep 3 && npm run dev:frontend",
    "kill-ports": "kill-port 41234 5173 4173 || true",
    "open:frontend": "wait-on http://localhost:5173 && open http://localhost:5173",
    "dev:stop": "kill-port 41234 5173 4173 || true",
    "dev:reset": "rimraf frontend/dev-dist frontend/dist frontend/.vite dist backend/dist .turbo",
    "dev:safe": "npm run kill-ports && concurrently --raw --success=all --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend:safe\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:frontend:safe": "cd frontend && npm run dev",
    "dev:stop:force": "node scripts/kill-dev.mjs",
    "cmd": "node run-command.js",
    "plan": "node run-command.js @plan",
    "act": "node run-command.js @act",
    "status": "node run-command.js @status",
    "test-cmd": "node run-command.js @test",
    "deploy": "node run-command.js @deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.6.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "axe-core": "^4.10.3",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.6",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "kill-port": "^2.0.1",
    "lint-staged": "^15.2.10",
    "open": "^10.2.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "turbo": "^2.5.6",
    "wait-on": "^7.2.0"
  },
  "packageManager": "npm@10.8.1",
  "dependencies": {
    "text-to-svg": "^3.1.5"
  }
}
